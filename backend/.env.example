# Copy to backend/.env. Outside Docker, `npm run dev`, `npm start`, `npm test`
# and `npm run migrate` read it. compose.yml reads it too, and there any secret
# left empty is generated on first boot.

# Encrypts MFA secrets. Outside Docker, set any long random string.
# Changing it later disables every account's two-factor sign-in.
APP_KEY=

# Outside Docker only; compose builds its own from the MYSQL_* values below.
# mysql://USER:PASSWORD@localhost:3306/habit_shaper
DATABASE_URL=
# Outside Docker only, for `npm test`. The suite wipes it, so its name must contain "test".
# mysql://root:PASSWORD@localhost:3306/habit_shaper_test
TEST_DATABASE_URL=

# Empty outside Docker: rate limits then count in memory. compose points it at its redis.
REDIS_URL=

# Outside Docker only; compose pins the container to 0.0.0.0:3000.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Docker only: the MySQL account the `db` container creates on its first boot.
MYSQL_DATABASE=habit_shaper
MYSQL_USER=habit
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Docker only: the password the `redis` container requires.
REDIS_PASSWORD=
