{
  "name": "habit-shaper-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import ./src/alias.ts --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import ./src/alias.ts src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import ./test/setup.ts --import ./src/alias.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "migrate": "node --env-file-if-exists=.env --import ./src/alias.ts src/migrate.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/bearer-auth": "^10.1.3",
    "@fastify/compress": "^9.2.0",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/mysql": "^5.0.3",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.2.0",
    "@node-rs/argon2": "^2.2.1",
    "ajv-errors": "^3.0.0",
    "close-with-grace": "^2.5.0",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "mysql2": "^3.24.4",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~7.0.2"
  }
}
